# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys / Developers → Webhooks in the Stripe
# Dashboard). Use test-mode values (sk_test_… / whsec_…) until you're ready
# to accept real payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (resend.com/api-keys) — transactional email for seller
# verification (submission confirmation + admin notification + decision
# email). Until a sending domain is verified in Resend, EMAIL_FROM must
# stay on their shared onboarding@resend.dev address, which only delivers
# to the Resend account's own verified email. Without RESEND_API_KEY set,
# these emails are skipped (logged, not sent) — everything else still works.
RESEND_API_KEY=
EMAIL_FROM=Durqo <onboarding@resend.dev>

# SSLCommerz (Bangladesh payment gateway — merchant.sslcommerz.com). Use
# their public sandbox demo credentials (Store ID "testbox", Password
# "qwerty" — not secret, published on developer.sslcommerz.com) until the
# full session→IPN→callback flow is verified end-to-end; only then switch
# to the real Store ID/Password from your SSLCommerz onboarding email by
# setting SSLCOMMERZ_IS_LIVE=true and swapping the two values below. Get
# these from your SSLCommerz Merchant Panel, and register
# <your-domain>/api/sslcommerz/ipn as the IPN listener URL there under
# My Store → IPN Settings.
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_LIVE=false

# Secret for the daily auto-sync cron job (src/app/api/cron/sync/route.ts,
# scheduled in vercel.json). Generate any long random string and set it as
# an environment variable in the Vercel project — Vercel automatically sends
# it back as `Authorization: Bearer <value>` on every cron-triggered
# request, which is how the route tells a real cron run apart from anyone
# else hitting the URL. Without this set, the cron route refuses to run.
CRON_SECRET=

# Asset Transfer System v2 — feature flag (src/lib/asset-transfer-room.ts).
# Leave unset/false until migrations 034-037 have been run in Supabase (see
# claude/asset-transfer-system-v2-phase-0-1-implementation-addendum.md).
# Once true, the Stripe/SSLCommerz/Escrow.com webhooks create a Transfer
# Room for every order as its payment is confirmed.
ASSET_TRANSFER_ROOMS_ENABLED=false

# Google Analytics 4 (analytics.google.com -> Admin -> Data Streams -> your
# web stream -> Measurement ID, format G-XXXXXXXXXX). Wired up in
# src/app/layout.tsx via @next/third-parties/google's <GoogleAnalytics>
# component. Leave unset to skip loading GA entirely (e.g. local dev).
# NEXT_PUBLIC_* vars are baked in at build time — set this in Vercel's
# Environment Variables and redeploy, a dashboard-only save isn't enough.
NEXT_PUBLIC_GA_ID=

# Google Tag Manager (tagmanager.google.com -> container ID, format
# GTM-XXXXXXX). Wired up in src/app/layout.tsx via @next/third-parties/
# google's <GoogleTagManager> component, plus a hand-added <noscript>
# fallback iframe (that component doesn't include one). Drives the Meta
# (Facebook) Pixel and future conversion tags from GTM's own console.
# Leave unset to skip loading GTM entirely (e.g. local dev). Same
# build-time-baked NEXT_PUBLIC_* rule as NEXT_PUBLIC_GA_ID above applies.
NEXT_PUBLIC_GTM_ID=

# Meta (Facebook) Conversions API — server-side purchase events, sent
# directly from src/lib/meta-capi.ts (see the Stripe/SSLCommerz/Escrow.com
# webhooks) rather than through a server-side GTM container. Separate from
# the browser-side Meta Pixel, which loads via GTM's own "Meta Pixel - Base
# Code" tag and isn't gated by anything in this app's own env vars.
# META_PIXEL_ID isn't a secret (pixel IDs are visible in every page's
# source) — get it from Meta Events Manager -> your dataset -> Settings.
# META_CAPI_ACCESS_TOKEN IS a secret (a Meta System User access token, from
# Events Manager -> Conversions API -> "Set up direct integration" ->
# generate access token) — set it as a Secret-type env var in Vercel, never
# committed here. Leave either unset to skip server-side CAPI entirely;
# sendMetaPurchaseEvent() no-ops safely without them.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# "Buy Now — Pay Later" checkout option (src/app/api/pay-later/init,
# src/lib/asset-transfer-room.ts's payLaterEnabled()). Defaults to ON
# (unlike the flag above) — set to "false" here to turn this checkout
# option off without a code redeploy. Live for every signed-in buyer: it
# creates a real order and marks the listing "sold" with no payment
# actually collected. See claude/pay-later-admin-test-checkout-addendum.md
# for the full history of this decision.
PAY_LATER_ENABLED=true

# Cloudflare Turnstile — bot protection on the register/login forms
# (src/components/TurnstileWidget.tsx), wired into Supabase Auth's own
# built-in CAPTCHA check (Authentication -> Attack Protection -> Enable
# CAPTCHA protection in the Supabase dashboard, where the Secret Key goes).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY isn't a secret (site keys are visible in
# every page's source) and is the only half this app itself needs -- get
# both keys from Cloudflare -> Turnstile -> Add a site. Leave unset to skip
# rendering the widget entirely (local dev, or before Supabase's own
# CAPTCHA protection toggle is turned on) -- see TurnstileWidget.tsx's
# captchaRequired export, which both forms gate their submit button on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
