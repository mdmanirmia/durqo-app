# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys / Developers → Webhooks in the Stripe
# Dashboard). Use test-mode values (sk_test_… / whsec_…) until you're ready
# to accept real payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (resend.com/api-keys) — transactional email for seller
# verification (submission confirmation + admin notification + decision
# email). Until a sending domain is verified in Resend, EMAIL_FROM must
# stay on their shared onboarding@resend.dev address, which only delivers
# to the Resend account's own verified email. Without RESEND_API_KEY set,
# these emails are skipped (logged, not sent) — everything else still works.
RESEND_API_KEY=
EMAIL_FROM=Durqo <onboarding@resend.dev>
